{
  "name": "dsh-skills-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skills settings for DeepSeek Harness: install, add, edit, and validate agent skills on disk, see what the registry actually serves to agents, and block conflicting saves.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CONTRACT.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "settings",
    "agent-skills",
    "skill-manager"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.5"
  },
  "license": "MIT",
  "author": "Stijnus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-skills-manager.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-skills-manager#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-skills-manager/issues"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && for f in src/*.js; do node --check \"$f\"; done"
  }
}
